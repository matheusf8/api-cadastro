# Copie para .env e preencha. NUNCA suba o .env para o Git.

# "dev" ou "production". Em production, uma SECRET_KEY fraca impede a API de subir.
ENVIRONMENT=dev

# Gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Máximo de falhas de login por (IP + e-mail) dentro da janela, em segundos
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

DATABASE_URL=sqlite:///./app.db

# Em produção use a URL do Postgres (ex.: Neon): postgresql://usuario:senha@host/banco

# Origem do frontend liberada no CORS
FRONTEND_ORIGIN=http://localhost:5173

# Cadastro restrito (deploy). Vazio = cadastro livre; preenchido = exige o código.
INVITE_CODE=
# Teto de contas. 0 = sem limite.
MAX_USERS=0
